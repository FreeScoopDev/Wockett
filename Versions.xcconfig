// Version numbers for the app + widget targets. Both targets read this file, so
// bump values here — never in per-target build settings.
//
// MARKETING_VERSION is the user-facing version ("1.10" in the App Store).
//
// CURRENT_PROJECT_VERSION is the build number. Info.plist resolves CFBundleVersion
// from $(CURRENT_PROJECT_VERSION), so this value MUST stay defined — without it the
// build falls back to "1" from project.pbxproj and App Store Connect rejects the
// upload (build numbers must always increase).
//
// Who owns the build number:
//   - Release Flow (Xcode Cloud) is the only release path since 2026-09-23. It
//     IGNORES this value and auto-increments one counter shared by every Xcode
//     Cloud workflow. Its number is the one that ships; read it off the build.
//   - A manual Xcode archive uses THIS value verbatim. That is emergency-only
//     now (Xcode Cloud itself down).
//   - App Store Connect is authoritative for what actually shipped.
//
// So this number is NOT bumped after releases any more (that was #35, #39,
// #57). If an emergency manual archive is refused because the number is taken,
// raise it above the latest build in App Store Connect then.
//
// Last manual archive: v1.12, build 84, 2026-09-23, built from 337f39c
// without #53 (proved from the archive's dSYM; see the #53 CHANGELOG entry).
MARKETING_VERSION = 1.12
CURRENT_PROJECT_VERSION = 85

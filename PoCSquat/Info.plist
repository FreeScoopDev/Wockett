<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Wockett</string>
	<key>CFBundleName</key>
	<string>Wockett</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>Wockett uses the camera to detect your body position and count squat and push-up reps.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Wockett reads your step count from Apple Health to track your daily walking goal.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Wockett does not write data to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wockett uses your location to suggest nearby walking routes, track your position during in-app navigation, and calculate distances. Route coordinates are sent to a free elevation service (opentopodata.org) to display elevation profiles.</string>
	<key>NSMotionUsageDescription</key>
	<string>Wockett uses motion data to count your steps when Apple Health is unavailable.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Wockett adds walk reminders to your Reminders app to help you hit your daily step goal.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
